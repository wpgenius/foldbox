{
	"name": "foldbox",
	"version": "1.0.1",
	"description": "Lightweight lightbox and filterable grid for photos and videos: thumbnails, zoom, fullscreen, slideshow, YouTube, Vimeo and MP4.",
	"main": "dist/foldbox.min.js",
	"style": "dist/foldbox.min.css",
	"files": [
		"src",
		"dist"
	],
	"scripts": {
		"build": "esbuild src/foldbox.js --minify --legal-comments=inline --target=es2018 --outfile=dist/foldbox.min.js && esbuild src/foldbox.css --minify --legal-comments=inline --outfile=dist/foldbox.min.css"
	},
	"keywords": [
		"lightbox",
		"gallery",
		"video",
		"youtube",
		"vimeo",
		"zoom",
		"filter",
		"grid"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wpgenius/foldbox.git"
	},
	"author": "WPGenius",
	"license": "MIT",
	"devDependencies": {
		"esbuild": "0.24.0"
	}
}
